# ==============================================================================
# KisanVerify Environment Configuration (.env)
# ==============================================================================
# Sensible defaults are provided for all parameters. If no .env file exists,
# KisanVerify automatically falls back to an embedded SQLite database and
# deterministic rule-based AI template explanations.
# ==============================================================================

# --- Server & Environment ---
# Options: development, staging, production
ENVIRONMENT=development
# Host to bind (0.0.0.0 listens on all network interfaces)
HOST=0.0.0.0
# Port to run FastAPI backend (default: 8000)
PORT=8000

# --- Database Connection ---
# Default: Local SQLite database stored in backend root
# PostgreSQL / Supabase example: postgresql://user:password@host:5432/kisanverify
DATABASE_URL=sqlite:///./kisanverify.db

# --- Security & JWT Sessions ---
# Secret key used for signing session tokens and hashing (minimum 32 characters in production)
SECRET_KEY=kisanverify-demo-secret-key-32-chars-minimum-prod
# Token validity in minutes (1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- CORS Allowed Origins ---
# Comma-separated list of origins permitted to call the backend API directly.
# Relative calls through the Vite dev proxy do not trigger CORS restrictions.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# --- Artificial Intelligence & Policy Simplifier ---
# Optional: Google Gemini API Key.
# When empty, KisanVerify uses its deterministic, rule-based template simplifier
# in Hindi and English. Financial arithmetic is NEVER computed by the LLM.
GEMINI_API_KEY=
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash

# --- Frontend Client Configuration (Vite) ---
# When using the Vite dev proxy, this defaults to relative '/api/v1'.
# Set to an absolute URL only if hosting frontend separately from backend without proxy.
VITE_API_URL=/api/v1
