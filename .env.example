# ==============================================
# KisanVerify Environment Variables Example
# ==============================================

# Backend Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
DATABASE_URL=sqlite:///./kisanverify.db
SECRET_KEY=kisanverify-demo-secret-key-32-chars-minimum-prod
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM / AI Configuration (Gemini by default; graceful template fallback active when omitted)
GEMINI_API_KEY=
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash

# Frontend Configuration (for Vite)
VITE_API_BASE_URL=http://localhost:8000
